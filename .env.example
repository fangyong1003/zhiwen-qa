# Web 与数据库
PORT=8787
MYSQL_URL=mysql://zhiwen:change-this-password@127.0.0.1:3306/zhiwen
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
UPLOAD_DIR=./uploads
MYSQL_DATABASE=zhiwen
MYSQL_USER=zhiwen
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# 可选：同时填写邮箱和密码才会自动创建管理员；留空则在登录页初始化。
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=系统管理员

# Embedding 统一使用 OpenAI；问答可选择 OpenAI 或 DeepSeek。
# 密钥可暂时留空以验证账号与管理页面；上传索引和提问前必须填写 OpenAI 密钥。
# 模型名请按实际账号可用模型填写，并在正式试用前完成真实调用验证。
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
