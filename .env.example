# Web 与数据库
PORT=8787
MYSQL_URL=mysql://zhiwen:change-this-password@127.0.0.1:3306/zhiwen
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
UPLOAD_DIR=./uploads
# 问答输入预算（保守估算，不是供应商精确 token 计数），超出时压缩摘要、历史和检索片段。
CHAT_CONTEXT_TOKENS=24000
MYSQL_DATABASE=zhiwen
MYSQL_USER=zhiwen
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# 可选：同时填写邮箱和密码才会自动创建管理员；留空则在登录页初始化。
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=系统管理员

# 文档和问题向量统一使用 Gemini；问答默认 Gemini，也可选择 OpenAI 或 DeepSeek。
# 密钥可暂时留空以验证账号与管理页面；上传索引和提问前必须填写 Gemini 密钥。
# 模型名请按实际账号可用模型填写，并在正式试用前完成真实调用验证。
# 以下密钥仅在选择对应模型回答时需要。
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# 可选：留空使用 https://api.deepseek.com；仅配置可信的服务端代理。
DEEPSEEK_BASE_URL=

# Gemini API 密钥只保存在服务端。默认为 Google 官方 Gemini Developer API。
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# 支持 gemini-embedding-2 和 gemini-embedding-001；修改模型或维度后需重建已有文档索引。
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
# 可选：用于服务端代理或本地协议测试；留空使用 Google 官方地址。
GEMINI_BASE_URL=
